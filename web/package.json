{
  "name": "maestro-d-hub-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "coverage": "tsc && NODE_DISABLE_COMPILE_CACHE=1 c8 --all --include 'src/**' --include '.test-build/**/*.js' --exclude '**/*.test.*' --exclude-after-remap --check-coverage --per-file --lines 90 mocha",
    "test": "tsc && mocha",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "mocha": "12.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "glob@^13": "14.0.6",
    "minimatch@^10": "11.0.9"
  }
}
